APP_ENV=dev
SECRET_KEY=change-me-in-production
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me
DATABASE_URL=sqlite:///./copilot.db
CORS_ORIGINS=http://localhost:3000
POLICY_PATH=../policy.yaml
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Optional OpenAI-compatible provider (leave blank for template-based generation)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ── Email notifications ───────────────────────────────────────────────────────
# Gmail: create an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
NOTIFY_EMAIL_TO=you@gmail.com
NOTIFY_SCORE_THRESHOLD=80.0

# ── Job discovery worker ──────────────────────────────────────────────────────
DISCOVERY_ENABLED=false
DISCOVERY_SEARCH_TERMS=software engineer
DISCOVERY_LOCATION=remote

# Greenhouse: comma-separated company slugs (from boards.greenhouse.io/{slug})
DISCOVERY_GREENHOUSE_COMPANIES=

# Lever: comma-separated company slugs (from jobs.lever.co/{slug})
DISCOVERY_LEVER_COMPANIES=
